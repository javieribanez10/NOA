# Imagen base de Node (versión 18 en Alpine Linux)
FROM node:18-alpine

# Establecer el directorio de trabajo en /app
WORKDIR /app

# Copiar únicamente package.json y package-lock.json para aprovechar la caché de dependencias
COPY package*.json ./

# Instalar dependencias
RUN npm install

# Copiar el resto del código al contenedor
COPY . .

# Argumento para determinar el modo de build: "app" o "widget"
ARG MODE=app

# Ejecutar el build según el modo especificado y mover la salida a la carpeta "public"
RUN if [ "$MODE" = "widget" ]; then \
      npm run build:widget && mkdir -p public && mv widget/* public/; \
    else \
      npm run build && mkdir -p public && mv dist/* public/; \
    fi

# Listar el contenido de la carpeta "public" (para depuración)
RUN ls -la public

# Exponer el puerto para el servidor estático (se usará el 5173 dentro del contenedor)
EXPOSE 5173

# Instalar 'serve' de forma global para servir los archivos estáticos
RUN npm install -g serve

# Definir el comando de arranque (sirve la carpeta "public")
CMD ["serve", "public", "-l", "5173"]
